# ---- Pipeline existant ----
YOUTUBE_API_KEY=
OPENAI_API_KEY=
EMAIL_FROM=
EMAIL_TO=
GOOGLE_DRIVE_FOLDER_ID=
DATABASE_URL=

# ---- Instagram Graph API (compte Pro lie a une Page Facebook) ----
# Etapes Meta (compter plusieurs jours pour l'app review) :
#  1. developers.facebook.com -> creer une app type "Business"
#  2. Ajouter le produit "Instagram Graph API"
#  3. Lier le compte IG Business/Creator a une Page Facebook
#  4. Generer un token long-lived (60j) avec les permissions :
#       instagram_basic, instagram_manage_insights, pages_show_list,
#       pages_read_engagement
#     + instagram_manage_messages (pour le nombre de DM) -> app review
#  5. Recuperer l'IG User ID (Graph API Explorer : me/accounts -> instagram_business_account)
IG_USER_ID=
IG_ACCESS_TOKEN=

# ---- Publication Google Sheets (compte de service) ----
# Chemin du fichier JSON OU contenu JSON brut du compte de service.
# Partager le spreadsheet avec l'email du compte de service.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- API serverless (filtrage par role) ----
# Secret partage entre le dashboard CEO et cette API. Le dashboard
# authentifie l'utilisateur puis envoie ce token + l'email.
DASHBOARD_API_TOKEN=
