# ---------------------------------------------------------------------------
# Application d'assistance au closing - Cabinet Dr Alexis Delobaux
# Copiez ce fichier vers .env.local et renseignez vos clés réelles.
# ---------------------------------------------------------------------------

# Deepgram - Transcription audio temps réel (https://deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Anthropic Claude - Recommandations & scoring IA (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key
# Modèle Claude utilisé (par défaut : claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Supabase - Base de données & authentification (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Clé service role (serveur uniquement, ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Cloud OAuth 2.0 - Intégration Drive & Gmail
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
# Dossier Google Drive où archiver les transcriptions/analyses
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
# Adresse expéditrice utilisée pour les emails patients via Gmail
GMAIL_SENDER_ADDRESS=cabinet@exemple.com

# URL publique de l'application (utilisée pour les callbacks OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
